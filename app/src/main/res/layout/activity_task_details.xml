<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark">

    <!-- Верхняя панель (AppBar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnDetBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад"
            tools:ignore="TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/tvDetName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="SD CARD ⇄ WebDAV" />

        <ImageButton
            android:id="@+id/btnDetEdit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_edit"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Редактировать задание"
            tools:ignore="TouchTargetSizeCheck" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Карточка статуса -->
            <LinearLayout
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@color/surface_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tvDetTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="SD CARD ⇄ WebDAV" />
                    <TextView
                        android:id="@+id/tvDetStatusIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        tools:text="✔"
                        tools:textColor="@color/success_green" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDetType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:background="@drawable/bg_button_secondary"
                    android:padding="6dp"
                    tools:text="⇄ Двусторонняя" />

                <TextView
                    android:id="@+id/tvDetLastRun"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="📅 14.08.2026 12:00" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tvDetSchedule"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="⏰ Расписание: ежедневно 03:00" />
                    <Button
                        android:id="@+id/btnDetRun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▶ Запуск"
                        android:background="@drawable/bg_button_secondary"
                        android:textColor="@color/text_secondary"
                        android:minHeight="40dp" />
                </LinearLayout>

                <!-- Круглые действия -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageButton
                            android:id="@+id/btnDetCopy"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_circle_light"
                            android:src="@android:drawable/ic_menu_agenda" 
                            android:contentDescription="Копировать задание" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Копировать"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageButton
                            android:id="@+id/btnDetDelete"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_circle_red"
                            android:src="@android:drawable/ic_menu_delete"
                            android:contentDescription="Удалить задание" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Удалить"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Вкладки (Чипы) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">
                <Button
                    android:id="@+id/chipMain"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Основные"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:background="@drawable/bg_button_primary"
                    android:textColor="@color/black" />
                <Button
                    android:id="@+id/chipPlan"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Планирование"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:background="@drawable/bg_button_secondary"
                    android:textColor="@color/text_secondary" />
                <Button
                    android:id="@+id/chipSync"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Дополнительно"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:background="@drawable/bg_button_secondary"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Панель: Основные -->
            <LinearLayout
                android:id="@+id/panelMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Тип синхронизации"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold" />
                    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_rounded_dark"
                    android:padding="16dp"
                    android:layout_marginTop="4dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvDetSyncType"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Двусторонняя" />
                            
                        <Button
                            android:id="@+id/btnEditType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="Редактировать"
                            android:background="?attr/selectableItemBackground"
                            android:textColor="@color/primary_blue"
                            android:textSize="13sp" />
                    </LinearLayout>
                    
                    <TextView
                        android:id="@+id/tvDetSyncTypeDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/hint_gray"
                        android:textSize="12sp"
                        tools:text="Синхронизирует изменения как в левой, так и в правой папке." />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Левая папка"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_rounded_dark"
                    android:padding="16dp"
                    android:layout_marginTop="4dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvDetLeftLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Память устройства" />
                        <Button
                            android:id="@+id/btnEditLeft"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="Редактировать"
                            android:background="?attr/selectableItemBackground"
                            android:textColor="@color/primary_blue"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvDetLeftPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/primary_blue"
                        android:textSize="12sp"
                        tools:text="📁 DCIM" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Правая папка"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_rounded_dark"
                    android:padding="16dp"
                    android:layout_marginTop="4dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvDetRightLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="WebDAV" />
                        <Button
                            android:id="@+id/btnEditRight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="Редактировать"
                            android:background="?attr/selectableItemBackground"
                            android:textColor="@color/primary_blue"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvDetRightPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/primary_blue"
                        android:textSize="12sp"
                        tools:text="/backups/photos/" />
                </LinearLayout>
            </LinearLayout>

            <!-- Панель: Планирование -->
            <LinearLayout
                android:id="@+id/panelPlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Планирование"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_rounded_dark"
                    android:padding="16dp"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:id="@+id/tvPlanSchedule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Ежедневно в 03:00" />
                    <TextView
                        android:id="@+id/tvPlanDays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/hint_gray"
                        android:textSize="13sp"
                        tools:text="Дни: каждый день" />
                    <Button
                        android:id="@+id/btnEditPlan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="8dp"
                        android:text="Редактировать"
                        android:background="?attr/selectableItemBackground"
                        android:textColor="@color/primary_blue"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Панель: Дополнительно -->
            <LinearLayout
                android:id="@+id/panelSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Дополнительно"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_rounded_dark"
                    android:padding="16dp"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:id="@+id/tvSyncNetwork"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="Wi-Fi: вкл\nМобильная сеть: выкл" />
                    <TextView
                        android:id="@+id/tvSyncNotify"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="Уведомления: при успехе, при ошибке" />
                    <Button
                        android:id="@+id/btnEditSync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="8dp"
                        android:text="Редактировать"
                        android:background="?attr/selectableItemBackground"
                        android:textColor="@color/primary_blue"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>