<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark">

    <TextView
        android:id="@+id/tvWizardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Создать задание"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"
        tools:text="Редактировать задание" />

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:inAnimation="@anim/slide_in_right"
        android:outAnimation="@anim/slide_out_left">

        <!-- Шаг 1 -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Тип синхронизации" android:textColor="@color/text_primary"
                    android:textSize="16sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/cardTwoWay" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:background="@drawable/bg_rounded_dark"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:padding="16dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⇄ Двусторонняя" android:textColor="@color/text_primary"
                        android:textStyle="bold" android:textSize="15sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Синхронизация в обе стороны: новые файлы появляются и на телефоне, и на сервере"
                        android:textColor="@color/hint_gray" android:textSize="12sp" android:layout_marginTop="4dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/cardToRight" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:background="@drawable/bg_rounded_dark"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:padding="16dp" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="→ В правую папку" android:textColor="@color/text_primary"
                        android:textStyle="bold" android:textSize="15sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Левая → правая (загрузка с телефона на сервер)"
                        android:textColor="@color/hint_gray" android:textSize="12sp" android:layout_marginTop="4dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/cardToLeft" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:background="@drawable/bg_rounded_dark"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="← В левую папку" android:textColor="@color/text_primary"
                        android:textStyle="bold" android:textSize="15sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Правая → левая (скачивание с сервера на телефон)"
                        android:textColor="@color/hint_gray" android:textSize="12sp" android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Шаг 2 -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Левая папка" android:textColor="@color/text_primary"
                    android:textSize="16sp" android:textStyle="bold" />
                <Button android:id="@+id/btnLeftLocal" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:layout_marginTop="12dp" android:text="📱 Память устройства"
                    android:background="@drawable/bg_button_secondary" android:textColor="@color/text_secondary" />
                <Button android:id="@+id/btnLeftWebdav" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:layout_marginTop="8dp" android:text="☁ WebDAV"
                    android:background="@drawable/bg_button_secondary" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/tvLeftSelected" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="Не выбрано" android:textColor="@color/hint_gray"
                    android:textSize="13sp" tools:text="📱 DCIM" />
            </LinearLayout>
        </ScrollView>

        <!-- Шаг 3 -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Правая папка" android:textColor="@color/text_primary"
                    android:textSize="16sp" android:textStyle="bold" />
                <Button android:id="@+id/btnRightLocal" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:layout_marginTop="12dp" android:text="📱 Память устройства"
                    android:background="@drawable/bg_button_secondary" android:textColor="@color/text_secondary" />
                <Button android:id="@+id/btnRightWebdav" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:layout_marginTop="8dp" android:text="☁ WebDAV"
                    android:background="@drawable/bg_button_secondary" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/tvRightSelected" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="Не выбрано" android:textColor="@color/hint_gray"
                    android:textSize="13sp" tools:text="☁ WebDAV: /backups/" />
            </LinearLayout>
        </ScrollView>

        <!-- ==================== Шаг 4: Расписание и условия ==================== -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- НОВОЕ: секция РАСПИСАНИЕ (скрывается при редактировании «Дополнительно») -->
                <LinearLayout
                    android:id="@+id/llPlanSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <CheckBox
                        android:id="@+id/cbSchedule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Синхронизация по расписанию"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/primary_blue"
                        android:checked="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Расписание"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spScheduleMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_dark"
                        android:popupBackground="@color/surface_dark" />

                    <LinearLayout
                        android:id="@+id/llInterval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Интервал:"
                            android:textColor="@color/text_secondary" />

                        <Spinner
                            android:id="@+id/spInterval"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_input_dark"
                            android:popupBackground="@color/surface_dark" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="12dp"
                        android:text="⏰ Время: 12:00"
                        android:background="@drawable/bg_button_secondary"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Дни недели:"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/llWeek"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <Button
                        android:id="@+id/btnMonthDays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="12dp"
                        android:text="📅 Числа месяца: не выбраны"
                        android:background="@drawable/bg_button_secondary"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- НОВОЕ: секция УСЛОВИЯ + УВЕДОМЛЕНИЯ (скрывается при редактировании «Планирование») -->
                <LinearLayout
                    android:id="@+id/llSyncSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Условия"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/cbWifi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Использовать Wi-Fi"
                        android:textColor="@color/text_secondary"
                        android:buttonTint="@color/primary_blue"
                        android:checked="true" />

                    <CheckBox
                        android:id="@+id/cbMobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Использовать мобильную сеть"
                        android:textColor="@color/text_secondary"
                        android:buttonTint="@color/primary_blue" />

                    <CheckBox
                        android:id="@+id/cbCharging"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Только при зарядке"
                        android:textColor="@color/text_secondary"
                        android:buttonTint="@color/primary_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Уведомления"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/cbNotifyOk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="При успешной синхронизации"
                        android:textColor="@color/text_secondary"
                        android:buttonTint="@color/primary_blue" />

                    <CheckBox
                        android:id="@+id/cbNotifyErr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="При ошибке синхронизации"
                        android:textColor="@color/text_secondary"
                        android:buttonTint="@color/primary_blue" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Шаг 5 -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Имя задания" android:textColor="@color/text_secondary"
                    android:textStyle="bold" />
                <EditText android:id="@+id/etTaskName" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:hint="SD CARD > WebDAV" android:textColor="@color/text_primary"
                    android:textColorHint="@color/hint_gray"
                    android:background="@drawable/bg_input_dark" android:padding="12dp"
                    android:importantForAutofill="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:text="Сводка настроек"
                    android:textColor="@color/text_secondary" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_dark" android:padding="14dp"
                    android:layout_marginTop="4dp">
                    <TextView android:id="@+id/tvSummary" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                        android:textSize="13sp" android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </ViewFlipper>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp">
        <Button android:id="@+id/btnWizardBack" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
            android:text="Отмена" android:background="@drawable/bg_button_secondary"
            android:textColor="@color/text_secondary"
            android:contentDescription="Отмена создания задания" />
        <Button android:id="@+id/btnWizardNext" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:minHeight="48dp" android:layout_marginStart="8dp"
            android:text="Следующий" android:background="@drawable/bg_button_primary"
            android:textColor="@color/black"
            android:contentDescription="Перейти к следующему шагу" />
    </LinearLayout>
</LinearLayout>