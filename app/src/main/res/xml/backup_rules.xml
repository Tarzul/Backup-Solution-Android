<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>

    <!-- ✅ Включаем домены -->
    <include domain="sharedpref" path="."/>
    <include domain="database" path="."/>
    <include domain="file" path="."/>

    <!-- ✅ Исключаем credentials -->
    <exclude domain="sharedpref" path="webdav_settings_encrypted.xml" />
    <exclude domain="sharedpref" path="webdav_settings.xml" />
    <exclude domain="sharedpref" path="secure_prefs.xml" />

    <!-- ✅ Исключаем базы данных -->
    <exclude domain="database" path="history.db" />
    <exclude domain="database" path="history.db-journal" />
    <exclude domain="database" path="workmanager.db" />

    <!-- ✅ Исключаем кэш и временные файлы -->
    <exclude domain="file" path="thumbs/" />
    <exclude domain="file" path="previews/" />
    <exclude domain="file" path="webdav_http_cache/" />
    <exclude domain="file" path="videos/" />
    <exclude domain="file" path="sync_temp/" />
    <exclude domain="file" path="logs/" />

</full-backup-content>