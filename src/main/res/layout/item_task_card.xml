<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_rounded_dark"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:foreground="?attr/selectableItemBackground">
    
    <TextView android:id="@+id/tvTaskName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvTaskType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/tvTaskLastRun" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="2dp" />
    <TextView android:id="@+id/tvTaskSchedule" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="12sp" />
    
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
        <Button android:id="@+id/btnRun" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶ Запуск" android:background="@drawable/bg_button_primary" android:textColor="@color/black" android:minHeight="40dp" />
        <Button android:id="@+id/btnEdit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✏️" android:background="@drawable/bg_button_secondary" android:textColor="@color/text_secondary" android:layout_marginStart="8dp" android:minHeight="40dp" />
        <Button android:id="@+id/btnDelete" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🗑" android:background="@drawable/bg_button_secondary" android:textColor="@color/text_secondary" android:layout_marginStart="8dp" android:minHeight="40dp" />
    </LinearLayout>
</LinearLayout>