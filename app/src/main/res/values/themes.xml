<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.BackupApp" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Основные цвета бренда -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/primary_blue_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        
        <!-- Акцентный цвет (для чекбоксов, переключателей, прогресс-баров) -->
        <item name="colorAccent">@color/primary_blue</item>
        <item name="colorSecondary">@color/primary_blue</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        
        <!-- Поверхности -->
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorOnBackground">@color/text_primary</item>
        
        <!-- Системные бары -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_darker</item>
        <item name="android:navigationBarColor">@color/background_darker</item>
        
        <!-- ВАЖНО: Глобальный цвет для чекбоксов и контролов -->
        <item name="colorControlActivated">@color/primary_blue</item>
        <item name="colorControlNormal">@color/hint_gray</item>
        <item name="colorControlHighlight">@color/border_gray</item>
        
        <!-- Светлый текст на темном фоне -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/hint_gray</item>
        
        <!-- ИСПРАВЛЕНО: все диалоги — тёмные, даже если системная тема светлая -->
        <item name="alertDialogTheme">@style/DarkAlertDialog</item>
        <item name="android:alertDialogTheme">@style/DarkAlertDialog</item>
        
        <!-- Для Android 12+ (Material You) -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!-- ИСПРАВЛЕНО: единая тёмная тема для ВСЕХ диалогов приложения.
         Исправляет белый текст на белом фоне на устройствах со светлой системной темой. -->
    <style name="DarkAlertDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:background">#FF202020</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColor">#FFDDDDDD</item>
        <item name="android:textColorSecondary">#FFBBBBBB</item>
        <item name="textColorAlertDialogListItem">#FFFFFFFF</item>
        <item name="colorAccent">@color/primary_blue</item>
        <item name="buttonBarPositiveButtonStyle">@style/DarkDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DarkDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/DarkDialogButton</item>
    </style>

    <!-- ИСПРАВЛЕНО: кнопки в диалогах — читаемые на тёмном фоне -->
    <style name="DarkDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/primary_blue</item>
    </style>
</resources>